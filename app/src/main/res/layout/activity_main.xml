<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121824"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Aviator Sentinel"
        android:textColor="#00E676"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="10 Hz Screen Area Multiplier &amp; Streak Alert"
        android:textColor="#9E9E9E"
        android:textSize="14sp"
        android:layout_marginBottom="24dp" />

    <!-- Configuration Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1E293B"
        android:padding="16dp"
        android:layout_marginBottom="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Multiplier Threshold (Default &lt; 2.00x):"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etThreshold"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:inputType="numberDecimal"
            android:text="2.00"
            android:textColor="#FFFFFF"
            android:background="#0F172A"
            android:paddingHorizontal="12dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Consecutive Streak Target (Default 7):"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etStreakTarget"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:inputType="number"
            android:text="7"
            android:textColor="#FFFFFF"
            android:background="#0F172A"
            android:paddingHorizontal="12dp"
            android:layout_marginTop="6dp" />
    </LinearLayout>

    <Button
        android:id="@+id/btnPermissionOverlay"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="1. Grant Floating Permission"
        android:backgroundTint="#3B82F6"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnStartFloating"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="2. Start Floating HUD &amp; Crop"
        android:backgroundTint="#00E676"
        android:textColor="#000000"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="• Non-root • Offline ML Kit OCR • 10 checks/sec"
        android:textColor="#64748B"
        android:textSize="13sp" />
</LinearLayout>
